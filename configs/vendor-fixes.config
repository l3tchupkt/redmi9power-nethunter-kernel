# ==============================================================================
# Vendor Kernel Tree Compilation & Linker Fixes for Xiaomi Chime / Bengal
# Target: 4.19.225-lilium-perf (Clang / LLVM 19 + lld)
# ==============================================================================

# FIX 1: Disable CONFIG_DM_CRYPT
# dm-crypt.c references 'limit_swap_bios' in struct dm_target (backported from 5.9+
# without updating device-mapper.h). Disabled to prevent struct member compiler error.
# CONFIG_DM_CRYPT is not set

# FIX 2: Enable CONFIG_SWITCH
# wcd-mbhc-v2.c:2063 contains a vendor typo (#ifndef CONFIG_SWITCH instead of #ifdef).
# When CONFIG_SWITCH is set, accdet_data (struct switch_dev) is declared and the
# call to switch_dev_unregister is safely skipped. Required for 3.5mm headset jack detection.
CONFIG_SWITCH=y

# FIX 3: Disable generic Novatek NT36xxx driver
# Both drivers/input/touchscreen/nt36xxx and NT36672A compile duplicate symbols.
# Chime/Lime devices utilize the NT36672A panel variant. Generic driver disabled.
# CONFIG_TOUCHSCREEN_NT36XXX is not set

# FIX 4: Disable generic FocalTech FTS driver
# Generic focaltech_touch and FT8719 compile duplicate symbols.
# Chime/Lime devices utilize FT8719. Generic driver disabled.
# CONFIG_TOUCHSCREEN_FTS is not set

# FIX 5: Enable CONFIG_HQ_SYSFS_SUPPORT
# Touchscreen drivers FT8719 and NT36672A reference extern hq_regiser_hw_info().
# Enabling hqsysfs.c allows the linker to resolve Xiaomi hardware sysfs registration.
CONFIG_HQ_SYSFS_SUPPORT=y

# FIX 6: Disable CONFIG_DEBUG_FS
# Prevents unresolved __tracepoint_bus_* symbols in msm_bus adhoc driver during linking.
# CONFIG_DEBUG_FS is not set